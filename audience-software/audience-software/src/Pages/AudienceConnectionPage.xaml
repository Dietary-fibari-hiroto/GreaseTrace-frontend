<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="audience_software.src.Pages.AudienceConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:audience_software.src.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:audience_software.src.Components"
    mc:Ignorable="d"
    >

    <Grid Loaded=" Page_Loaded">
        <Image Source="/Assets/Images/chevron-left.svg" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10" Width="64" Height="64" Tapped="ReturnPage"/>
        <Grid
            x:Name="MainContent"
            Visibility="Collapsed"
            VerticalAlignment="Stretch"
      HorizontalAlignment="Stretch">
            
            <StackPanel Orientation="Vertical"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="20">

                <TextBlock Text="コントローラー側で発行されたURLを入力してください。" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                <Border
            BorderBrush="DimGray"
            BorderThickness="1"
            CornerRadius="10"
            Background="Black"
            Width="500"
            Height="50">
                    <Grid
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                Padding="10 0"
                >
                        <TextBox  HorizontalAlignment="Left" Foreground="White" PlaceholderText="https://rumos.dawn-waiting.com/sangria"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="ExceptionText" Visibility="Collapsed" HorizontalAlignment="Center" Foreground="Red" Text="接続がタイムアウトしました。URLを確認してください。"/>
                <Button Click="ConnectionSubmit" Background="#0097CE" Foreground="White" Content="コネクト" HorizontalAlignment="Stretch" VerticalAlignment="Center" Width="500" Height="50"/>

            </StackPanel>

        </Grid>
        <Grid x:Name="LoadingContent" Visibility="Collapsed">
            <controls:BounceControl>
                <controls:BounceControl.Child>
                    <Image Source="/Assets/Images/GreaseTraiceIcon.png"
                           Width="50"
                           Height="82"
                           />
                </controls:BounceControl.Child>
            </controls:BounceControl>
            <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="15" Text="サーバーへ接続しています..."
               Margin="0 10"/>
        </Grid>
        <Grid x:Name="CompletedContent"
              Visibility="Visible"
              >
            <TextBlock
                FontSize="20"
                FontWeight="Bold"
                Text="接続が完了しました。
画面共有を開始します。"
                VerticalAlignment="Center"
                
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>
        </Grid>
        <Grid x:Name="RunningContent"
              Visibility="Collapsed"
              >
            <TextBlock
                FontSize="20"
                FontWeight="Bold"
                Text="実行中です。"
                VerticalAlignment="Center"
                
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>
        </Grid>
        <Grid x:Name="EndContent"
              Visibility="Collapsed"
              >
            <StackPanel Orientation="Vertical"
                        Spacing="20"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock
    FontSize="20"
    FontWeight="Bold"
    Text="画面共有を終了しました。"
    VerticalAlignment="Center"
           TextWrapping="Wrap"
           HorizontalAlignment="Center"/>
                <Button Tapped="ReturnPage" Background="#0097CE" Foreground="White" Content="ホームへ戻る" HorizontalAlignment="Stretch" VerticalAlignment="Center" Width="500" Height="50"/>
            </StackPanel>
        </Grid>

    </Grid>
</Page>
