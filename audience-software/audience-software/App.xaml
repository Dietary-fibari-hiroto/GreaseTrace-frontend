<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="audience_software.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:audience_software">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Noto Sans JP" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
            <!-- Other app resources here -->
            <FontFamily x:Key="NotoSansJP">ms-appx:///Assets/Fonts/NotoSansJP/NotoSansJP-Regular.ttf#Noto Sans JP</FontFamily>
            <FontFamily x:Key="NotoSansJP-Bold">ms-appx:///Assets/Fonts/NotoSansJP/NotoSansJP-Regular.ttf#Noto Sans JP</FontFamily>

        </ResourceDictionary>
    </Application.Resources>
</Application>
