---
import { scrollToSection } from "../assets/utils/scroll"
import { ImagesRoute } from "../assets/ImagesRoute"
const sections = [
    {id:"hero",label:"Home"},
    {id:"concept",label:"Concept"},
    {id:"about",label:"About"},
    {id:"download",label:"Download"},
    {id:"member",label:"Member"},
    {id:"github",label:"GitHub"}
]
---

<header>
    <div class="apple-title-content">
        <img src = {ImagesRoute.GreaseTraiceIcon}/>
        <span class="text-3xl font-bold ">Grease Trace</span>
    </div>
    <nav class="text-lg">
        {sections.map(({id,label})=>(
            <button class=" text-lg font-medium" onclick={`(${scrollToSection.toString()})('${id}')`}>
                {label}
            </button>
        ))}
    </nav>
</header>





<style lang="scss">

    header{
        box-sizing: border-box;
        position:fixed;
        top:0;
        left:0;
        z-index: 99;
        width:100vw;
        height:50px;
        display:flex;
        justify-content: space-between;
        align-items: center;
        padding:0 10px;
        margin:10px 0;
        *{
        color:black;
    }

        .apple-title-content{
            display:flex;
            align-items:center;
            > img{
                height:3rem;
            }

        }
        .apple-title-content:last-child{
            margin-left:1rem;
        }

        nav{
            display:flex;
            align-items: center;
            
            > * + *{
                margin-left:3rem;
            }
        }
    }
</style>