---
import "../assets/styles/index.scss"
import Header from "./Header.astro"
import Footer from "./Footer.astro";

const {title = "GreaseTrace"} = Astro.props;
---
<html lang = "jp">
    <head>
        <meta charset = "utf-8"/>
        <link rel="icon" type = "image/png" href="../assets/images/GreaseTraiceIcon.png" />
        <meta name="viewport" content="width=device-width"/>
        <meta name="generator" content={Astro.generator}/>
        <title>{title}</title>
    </head>
    <body>
        <Header/>
        <main>
            <slot/>
        </main>
        <Footer/>
    </body>

</html>